{
  "name": "patrac-api",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patra",
      "database_id": "2854f53b-4640-4aad-8089-343f5b954a97",
      "migrations_dir": "../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "patrac-photos"
    }
  ],
  "vars": {
    "PATRAC_REGISTRATION_READY": "false",
    "PATRAC_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://patrac-lukasbednariks-3292s-projects.vercel.app,https://patrac.stopik.cz",
    "PATRAC_AUTH_BASE_URL": "https://patrac-api.bednarik.workers.dev",
    "PATRAC_MAIL_RELAY_URL": "https://patrac-lukasbednariks-3292s-projects.vercel.app/api/internal/account-mail"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
