{
  "name": "patrac-api",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patrac",
      "database_id": "2854f53b-4640-4aad-8089-343f5b954a97",
      "migrations_dir": "../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "patrac-photos"
    }
  ],
  "vars": {
    "PATRAC_AUTH_URL": "https://ngkwalqrywdytiieqemz.supabase.co",
    "PATRAC_REGISTRATION_READY": "false",
    "PATRAC_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000"
  }
}
